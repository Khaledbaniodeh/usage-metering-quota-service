# Example configuration for LOCAL DEVELOPMENT ONLY.
# Copy to `.env` and adjust if needed. `.env` is git-ignored and must never be committed.
# The values below are throwaway development examples, not real credentials.
#
# Phase 0 note: the service does not read any of these variables yet. They are listed
# because the approved architecture requires them; each one becomes active in the phase
# that implements it.

# HTTP server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# PostgreSQL credentials used by Docker Compose for the local database container
POSTGRES_DB=usage_metering
POSTGRES_USER=usage_metering
POSTGRES_PASSWORD=local-development-only

# Connection used by the service (local development)
DATABASE_URL=postgres://usage_metering:local-development-only@localhost:5432/usage_metering

# Dedicated database for integration tests; the test setup refuses names not ending in _test
TEST_DATABASE_URL=postgres://usage_metering:local-development-only@localhost:5432/usage_metering_test

# Database timeouts (milliseconds)
DB_STATEMENT_TIMEOUT_MS=5000
CONSUME_LOCK_TIMEOUT_MS=2000
