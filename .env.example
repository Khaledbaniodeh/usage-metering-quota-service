# Example configuration for LOCAL DEVELOPMENT ONLY.
# Copy to `.env` (git-ignored, never committed) and adjust as needed. Every value below is a
# throwaway development example, not a real credential.
#
# `npm run dev`, `npm run db:migrate` and the integration tests read `.env` automatically when it
# exists. `docker compose` also reads it for the variable substitutions in compose.yaml.

# --- Service (src/config/config.ts) ---------------------------------------------------------
# Required. PostgreSQL connection URL (postgres:// or postgresql://). Never logged.
DATABASE_URL=postgres://usage_metering:local-development-only@localhost:5432/usage_metering
# HTTP port (1-65535). The service always binds to 0.0.0.0.
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Maximum pooled connections (1-100).
DB_POOL_MAX=10
# How long to wait for a pooled connection, in milliseconds (100-60000).
DB_CONNECTION_TIMEOUT_MS=5000
# Maximum duration of any single SQL statement, in milliseconds (100-600000).
DB_STATEMENT_TIMEOUT_MS=5000
# How long a consume request waits for a quota-counter lock before answering
# 503 BUSY_RETRY, in milliseconds (10-60000).
DB_LOCK_TIMEOUT_MS=2000
# Graceful-shutdown deadline after SIGINT/SIGTERM, in milliseconds (1000-120000).
SHUTDOWN_TIMEOUT_MS=10000

# --- Integration tests -----------------------------------------------------------------------
# Dedicated test database. Its name MUST end in _test: the tests drop and recreate it.
TEST_DATABASE_URL=postgres://usage_metering:local-development-only@localhost:5432/usage_metering_test

# --- Docker Compose (compose.yaml) ------------------------------------------------------------
# Credentials of the local PostgreSQL container. Keep the password URL-safe: it is embedded in
# the api service's DATABASE_URL.
POSTGRES_DB=usage_metering
POSTGRES_USER=usage_metering
POSTGRES_PASSWORD=local-development-only
# Host ports (bound to 127.0.0.1 only).
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8080
