# Version control and CI metadata
.git/
.github/

# Dependencies and build output are produced inside the image
node_modules/
dist/
coverage/

# Environment files never enter an image
.env
.env.*

# Not needed to build or run the service or the example client
docs/
load/
tests/
*.md

# Logs, editors and operating-system files
*.log
npm-debug.log*
.idea/
.vscode/
.DS_Store
Thumbs.db
