# The image build copies only package files, tsconfig files and src/ explicitly; this file keeps
# everything else (and every secret) out of the build context.

# Version control, CI and editor metadata
.git/
.github/
.idea/
.vscode/

# Dependencies and outputs are produced inside the image
node_modules/
dist/
coverage/

# Environment files never enter an image
.env
.env.*

# Not needed to build or run the service
docs/
load/
tests/
*.md
compose*.yaml
eslint.config.js
vitest.config.ts
.prettierrc.json
.prettierignore

# Logs and operating-system files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
