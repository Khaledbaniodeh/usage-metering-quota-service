{
  "name": "usage-metering-quota-service",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service that meters usage and enforces account-level and user-level monthly quotas.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:migrations",
    "build:client": "tsc -p tsconfig.client.json",
    "build:migrations": "node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:client": "vitest run --project unit tests/unit/client",
    "test:load": "vitest run --project unit tests/unit/load",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "client:example": "node --import tsx client/main.ts",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "typebox": "^1.3.36"
  }
}
